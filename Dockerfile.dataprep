# CPU-only data-prep image: download AgentNet from HF, extract it, and upload the
# full uncompressed dataset to S3 as loose files (producer side of
# `download.py --full-s3`). No CUDA/torch/unsloth — this never trains, so it
# stays tiny and runs on the cheapest CPU box you can rent.
#
# This image is intended to be published publicly (Docker Hub), so it only
# contains the data-prep scripts — not the rest of the training code. The
# corresponding `Dockerfile.dataprep.dockerignore` whitelists exactly the files
# copied below.
#
# Build (no SSH agent / GitHub access required; just the local checkout):
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.dataprep -t omnibrowse-dataprep:latest .
#
# Run (forward AWS creds; mount big ephemeral/scratch disk at the data dir):
#   docker run --rm \
#     -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_DEFAULT_REGION \
#     -v /mnt/scratch:/workspace/OmniBrowse/dataset/agentnet/data \
#     omnibrowse-dataprep:latest
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    HF_HOME=/workspace/hf-cache

# p7zip for the split-zip extraction in download.py; ca-certificates for HTTPS
# to the Hub and S3.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates p7zip-full && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/OmniBrowse

# Lean deps only: download (huggingface_hub + hf_transfer), upload (boto3).
# Deliberately NOT requirements.txt, which drags in unsloth/torch/wandb.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip && \
    python -m pip install huggingface_hub hf_transfer boto3

# Ship only the data-prep code. The Dockerfile.dataprep.dockerignore whitelists
# exactly these files so the build context stays small and nothing else from
# the repo (training code, model configs, the cua/ venv) leaks into the image.
COPY dataprep.py download.py run_dataprep.sh ./

CMD ["bash", "run_dataprep.sh"]
